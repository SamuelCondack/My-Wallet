rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function subscriptionUnchanged() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(['subscription']);
    }

    function subscriptionCreateAllowed() {
      return !('subscription' in request.resource.data)
        || (
          request.resource.data.subscription.keys()
            .hasOnly(['status', 'planId', 'stripeCustomerId', 'stripeSubscriptionId', 'priceId', 'trialEndsAt', 'currentPeriodEnd', 'cancelAtPeriodEnd', 'updatedAt'])
          && request.resource.data.subscription.status == 'none'
          && request.resource.data.subscription.planId == 'free'
          && request.resource.data.subscription.stripeCustomerId == null
          && request.resource.data.subscription.stripeSubscriptionId == null
        );
    }

    function userSubscription(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.subscription;
    }

    // Mirrors client hasProAccess(): active/trialing with unexpired period dates.
    function hasPro(uid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(uid))
        && userSubscription(uid) != null
        && (
          (
            userSubscription(uid).status == 'active'
            && (
              !('currentPeriodEnd' in userSubscription(uid))
              || userSubscription(uid).currentPeriodEnd == null
              || userSubscription(uid).currentPeriodEnd > request.time
            )
          )
          || (
            userSubscription(uid).status == 'trialing'
            && (
              !('trialEndsAt' in userSubscription(uid))
              || userSubscription(uid).trialEndsAt == null
              || userSubscription(uid).trialEndsAt > request.time
            )
          )
        );
    }

    // Legacy expenses live directly under /{uid}/{expenseId}
    match /{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // User profile + billing state
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && subscriptionCreateAllowed();
      allow update: if isOwner(uid) && subscriptionUnchanged();
      allow delete: if false;
    }

    // Pro-only: category budgets (server-side entitlement)
    match /users/{uid}/categoryBudgets/{budgetId} {
      allow read: if isOwner(uid);
      allow create, update, delete: if isOwner(uid) && hasPro(uid);
    }

    // Nested user data (categories, income, favorites, etc.).
    // First path segment must not be categoryBudgets — Pro gate above owns that.
    match /users/{uid}/{document=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && !(document.size() > 0 && document[0] == 'categoryBudgets');
    }
  }
}
