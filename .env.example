# Frontend (Vite) — copy values into `.env` for local UI work
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: override functions base URL (defaults to /.netlify/functions)
# VITE_FUNCTIONS_BASE_URL=http://localhost:8888/.netlify/functions

# Netlify Functions / server — set in Netlify dashboard (or `netlify env:set`)
# Also needed locally when running `netlify dev`
APP_URL=http://localhost:8888
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
STRIPE_TRIAL_DAYS=7

# Firebase Admin (service account) for verifying ID tokens + writing subscription
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
